                        "color": "#8B9BAD"
                      }
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "\"PREFILL PRESS. (\" + {view.params.pressureUnits} + \")\""
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "ia.input.numeric-entry-field",
                    "meta": {
                      "name": "Field"
                    },
                    "position": {
                      "basis": "32px",
                      "grow": 0,
                      "shrink": 0
                    },
                    "props": {
                      "format": "0,0.0",
                      "style": {
                        "backgroundColor": "#0A0F14",
                        "color": "#E6EDF3",
                        "border": "1px solid #253241",
                        "borderRadius": "4px",
                        "fontFamily": "Consolas, 'Roboto Mono', 'Courier New', monospace",
                        "fontSize": "15px"
                      }
                    },
                    "propConfig": {
                      "props.value": {
                        "binding": {
                          "type": "property",
                          "config": {
                            "path": "view.custom.prefill",
                            "bidirectional": true
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Console"
        },
        "position": {
          "basis": "64px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "backgroundColor": "#0A0F14",
            "border": "1px solid #253241",
            "borderRadius": "6px",
            "padding": "6px 10px",
            "gap": "2px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Caption"
            },
            "position": {
              "basis": "14px",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "text": "PLC MESSAGE",
              "style": {
                "fontSize": "10px",
                "letterSpacing": "1.2px",
                "color": "#8B9BAD"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Message"
            },
            "position": {
              "basis": "auto",
              "grow": 1,
              "shrink": 1
            },
            "props": {
              "text": "",
              "style": {
                "fontFamily": "Consolas, 'Roboto Mono', 'Courier New', monospace",
                "fontSize": "13px",
                "whiteSpace": "normal",
                "alignItems": "flex-start",
                "overflowY": "auto"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "\"> \" + if(len(trim(coalesce({view.custom.message}, \"\"))) > 0, {view.custom.message}, \"No message\")"
                  }
                }
              },
              "props.style.color": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(len(trim(coalesce({view.custom.message}, \"\"))) > 0, \"#4ADE80\", \"#8B9BAD\")"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Footer"
        },
        "position": {
          "basis": "44px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "backgroundColor": "#151E28",
            "border": "1px solid #253241",
            "borderRadius": "6px",
            "padding": "0 12px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "auto",
              "grow": 1,
              "shrink": 1
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "13px",
                "color": "#E6EDF3"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.selected}, \"Station selected\", \"Station not selected\")"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.toggle-switch",
            "meta": {
              "name": "SelectToggle"
            },
            "position": {
              "basis": "60px",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "selected": false
            },
            "propConfig": {
              "props.selected": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.selected",
                    "bidirectional": true
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}
