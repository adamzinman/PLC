                "type": "ia.input.numeric-entry-field",
                "meta": {
                  "name": "Field"
                },
                "position": {
                  "basis": "84px",
                  "grow": 0,
                  "shrink": 0
                },
                "props": {
                  "format": "0,0.0",
                  "style": {
                    "fontSize": "13px",
                    "border": "1px solid #CBD2DC",
                    "borderRadius": "3px",
                    "backgroundColor": "#FFFFFF"
                  }
                },
                "propConfig": {
                  "props.value": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.prefill",
                        "bidirectional": true
                      }
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Message"
        },
        "position": {
          "basis": "auto",
          "grow": 1,
          "shrink": 1
        },
        "props": {
          "text": "",
          "style": {
            "margin": "8px 10px 10px",
            "padding": "6px 8px",
            "fontSize": "12px",
            "whiteSpace": "normal",
            "alignItems": "flex-start",
            "overflowY": "auto",
            "backgroundColor": "#FFFFFF",
            "borderLeftWidth": "4px",
            "borderLeftStyle": "solid",
            "minHeight": "40px"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len(trim(coalesce({view.custom.message}, \"\"))) > 0, {view.custom.message}, \"No message\")"
              }
            }
          },
          "props.style.borderLeftColor": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len(trim(coalesce({view.custom.message}, \"\"))) > 0, \"#D97706\", \"#CBD2DC\")"
              }
            }
          },
          "props.style.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len(trim(coalesce({view.custom.message}, \"\"))) > 0, \"#1F2933\", \"#64707D\")"
              }
            }
          }
        }
      }
    ]
  }
}
