                  "style": {
                    "fontSize": "12px",
                    "color": "#555555",
                    "paddingLeft": "6px"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "{view.params.weightUnits}"
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "MessageHeader"
            },
            "position": {
              "basis": "20px",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "text": "PLC MESSAGE",
              "style": {
                "fontSize": "11px",
                "fontWeight": "bold",
                "letterSpacing": "1px",
                "color": "#555555",
                "borderBottom": "1px solid #8C8C8C",
                "marginTop": "6px"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Message"
            },
            "position": {
              "basis": "54px",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "backgroundColor": "#E9E9E9",
                "border": "1px solid #8C8C8C",
                "padding": "4px 8px",
                "fontSize": "13px",
                "whiteSpace": "normal",
                "overflowY": "auto",
                "alignItems": "flex-start"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(len(trim(coalesce({view.custom.message}, \"\"))) > 0, {view.custom.message}, \"No message\")"
                  }
                }
              },
              "props.style.color": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(len(trim(coalesce({view.custom.message}, \"\"))) > 0, \"#1A1A1A\", \"#7A7A7A\")"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Footer"
        },
        "position": {
          "basis": "52px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "style": {
            "padding": "8px 12px"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "meta": {
              "name": "SelectButton"
            },
            "position": {
              "basis": "auto",
              "grow": 1,
              "shrink": 1
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "13px",
                "fontWeight": "bold",
                "borderRadius": "2px",
                "border": "1px solid #333333"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.selected}, \"DESELECT STATION\", \"SELECT STATION\")"
                  }
                }
              },
              "props.style.backgroundColor": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.selected}, \"#1F5FA8\", \"#CDCDCD\")"
                  }
                }
              },
              "props.style.color": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.selected}, \"#FFFFFF\", \"#1A1A1A\")"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tpath = \"%s/Selected\" % self.view.params.tagPath\n\tcurrent = system.tag.readBlocking([path])[0].value\n\tsystem.tag.writeBlocking([path], [not bool(current)])"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          }
        ]
      }
    ]
  }
}
