                  }
                }
              },
              "props.style.color": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(len(trim(coalesce({view.custom.message}, \"\"))) > 0, \"#1B2733\", \"#5B6B7F\")"
                  }
