        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.selected}, \"\u2713  Selected  (tap to deselect)\", \"Select Station\")"
              }
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.selected}, \"#1D5FD1\", \"#FFFFFF\")"
              }
            }
          },
          "props.style.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.selected}, \"#FFFFFF\", \"#1D5FD1\")"
              }
            }
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tpath = \"%s/Selected\" % self.view.params.tagPath\n\tcurrent = system.tag.readBlocking([path])[0].value\n\tsystem.tag.writeBlocking([path], [not bool(current)])"
              },
              "scope": "G",
              "type": "script"
            }
          }
        }
